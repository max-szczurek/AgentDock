@page
@model LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="card">
    <h1>Sign in</h1>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <p class="error">@Model.ErrorMessage</p> }
    @if (Model.GoogleEnabled)
    {
        <form method="post"><button type="submit">Sign in with Google</button></form>
    }
    else
    {
        <p class="muted">Google sign-in isn't configured.</p>
    }
</div>
